    "@emotion/react": "11.11.3",
    "@emotion/styled": "11.11.0",
    "reactflow": "11.10.4",
    "d3": "7.8.5",
    "axios": "1.6.7",
    "zustand": "4.5.0",
    "react-hook-form": "7.50.1",
    "@hookform/resolvers": "3.3.4",
    "zod": "3.22.4",
    "date-fns": "3.3.1",
    "notistack": "3.0.1"
