{
  "name": "cloud-data-platform-frontend",
  "version": "1.0.0",
  "description": "Cloud-independent data infrastructure platform - Frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
