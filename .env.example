# =============================================================================
# Cloud-Independent Data Infrastructure Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# All variables have sensible defaults for local development.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=cloud-data-platform
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
BCRYPT_COST_FACTOR=12
CREDENTIAL_ENCRYPTION_KEY=change-this-to-a-32-byte-hex-key-in-production
CSRF_SECRET_KEY=change-this-csrf-secret-in-production

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cloud_data_platform
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=platform_password
DATABASE_URL=postgresql+asyncpg://platform_user:platform_password@localhost:5432/cloud_data_platform

# -----------------------------------------------------------------------------
# ClickHouse Database (Lineage & Analytics)
# -----------------------------------------------------------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=lineage
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_password

# -----------------------------------------------------------------------------
# Redis (Cache, Rate Limiting, Token Blacklist)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@localhost:6379/0

# -----------------------------------------------------------------------------
# RabbitMQ (Message Broker for Celery)
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=platform_user
RABBITMQ_PASSWORD=rabbitmq_password
RABBITMQ_VHOST=/
CELERY_BROKER_URL=amqp://platform_user:rabbitmq_password@localhost:5672//

# -----------------------------------------------------------------------------
# Celery (Task Queue)
# -----------------------------------------------------------------------------
CELERY_RESULT_BACKEND=redis://:redis_password@localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=4

# -----------------------------------------------------------------------------
# Elasticsearch (Logs)
# -----------------------------------------------------------------------------
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=elastic_password
ELASTICSEARCH_URL=http://elastic:elastic_password@localhost:9200
ELASTICSEARCH_LOG_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Dagster (Pipeline Orchestration)
# -----------------------------------------------------------------------------
DAGSTER_HOME=/opt/dagster/dagster_home
DAGSTER_WEBSERVER_HOST=localhost
DAGSTER_WEBSERVER_PORT=3000
DAGSTER_PG_HOST=localhost
DAGSTER_PG_PORT=5432
DAGSTER_PG_DB=dagster
DAGSTER_PG_USER=dagster_user
DAGSTER_PG_PASSWORD=dagster_password

# -----------------------------------------------------------------------------
# dbt (SQL Transformations)
# -----------------------------------------------------------------------------
DBT_PROFILES_DIR=/opt/dbt/profiles
DBT_PROJECT_DIR=/opt/dbt/project

# -----------------------------------------------------------------------------
# Prometheus & Grafana (Observability)
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_password

# -----------------------------------------------------------------------------
# NGINX (Reverse Proxy)
# -----------------------------------------------------------------------------
NGINX_PORT=80
NGINX_SSL_PORT=443
NGINX_SERVER_NAME=localhost

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Notification Settings
# -----------------------------------------------------------------------------
NOTIFICATION_RETENTION_DAYS=30
NOTIFICATION_DEDUP_WINDOW_MINUTES=15

# -----------------------------------------------------------------------------
# Audit Log Settings
# -----------------------------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=730
AUDIT_LOG_STORAGE_WARNING_THRESHOLD=0.9
AUDIT_LOG_MAX_EXPORT_RECORDS=100000

# -----------------------------------------------------------------------------
# Lineage Settings
# -----------------------------------------------------------------------------
LINEAGE_RETENTION_DAYS=365
LINEAGE_MAX_TRAVERSAL_DEPTH=10

# -----------------------------------------------------------------------------
# Pipeline Settings
# -----------------------------------------------------------------------------
PIPELINE_MAX_NODES=50
PIPELINE_MAX_EDGES=100
PIPELINE_MAX_RETRIES=3
PIPELINE_STATUS_POLL_INTERVAL_SECONDS=5

# -----------------------------------------------------------------------------
# Payload Limits
# -----------------------------------------------------------------------------
MAX_PAYLOAD_SIZE_MB=10

# -----------------------------------------------------------------------------
# Air-Gapped Mode
# -----------------------------------------------------------------------------
AIR_GAPPED_MODE=false

# -----------------------------------------------------------------------------
# Account Security
# -----------------------------------------------------------------------------
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=24
